# Runtime data: state, archives, previews, logs. Never committed — it holds the
# user's digest history, and the archive can be large.
data/
archive/
preview/
logs/
state.json
config.json

# Secrets. The plugin reads <userData>/dsh-auto-email.secret.json, but a user
# experimenting locally may drop one here; never let it reach GitHub.
*.secret.json
.secret.json
.env
.env.*
# A locally hand-written config; `config.example.json` is the one that ships.
config.local.json

# Scratch space for throwaway probes and captured run output.
tmp/
*.log

# Regenerated by `node test/all.mjs --live`; the wiring is the committed artifact,
# not the snapshot of one afternoon's network conditions.
test/sources-live.out.txt

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Node
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
